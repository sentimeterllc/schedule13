# Schedule 13D/13G pipeline configuration.
# Copy to .env and fill in. Never commit the filled-in file.

# --- Filings API -----------------------------------------------------------
SECAPI_KEY=your-api-key-here
SECAPI_13DG_URL=https://api.sec-api.io/form-13d-13g
# The provider caps a page at 50 filings.
SCHEDULE13_PAGE_SIZE=50
SCHEDULE13_QUERY_PAUSE_SEC=2
SCHEDULE13_FILING_PAUSE_SEC=0.4
SCHEDULE13_RETRY_DELAY_SEC=5
SCHEDULE13_MAX_RETRIES=5
SCHEDULE13_HTTP_TIMEOUT=60

# --- Storage ---------------------------------------------------------------
# Archive of raw filing JSON, one file per accession number.
DOWNLOAD_PATH=C:/data/schedule13/downloads
# download_only | download_parse_save2db | parse_and_save2db
MODE=download_only
# Optional YYYYMMDD start date; otherwise the pipeline resumes from the latest
# filing already loaded.
# SCHEDULE13_START_DATE=20260101

# --- PostgreSQL ------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=tradingdata
# Reference tables (names are configurable so this drops into any schema).
SCHEDULE13_BIZCAL_TABLE=bizcal
SCHEDULE13_TICKER_TABLE=sec_info
